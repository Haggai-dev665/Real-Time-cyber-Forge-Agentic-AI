# Denial of Attack", which is wrong (Domain Generation Algorithm).
# @name chatTranslate
POST {{space}}/api/v2/chat
Content-Type: {{json}}

{
  "message": "Explain this alert in plain English.",
  "session_id": "rest-test-4",
  "context": {
    "translate": true,
    "raw_data": "{\"model\":\"dga_detector\",\"prediction\":\"dga\",\"threat_score\":0.9,\"features\":{\"entropy\":4.0,\"vowel_ratio\":0.0}}"
  }
}

