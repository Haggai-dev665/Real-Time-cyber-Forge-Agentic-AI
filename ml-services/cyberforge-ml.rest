POST {{space}}/api/models/predict
Content-Type: {{json}}

{
  "model_type": "malware_detection",
  "input_data": {
    "url_length": 78, "hostname_length": 12, "path_length": 32, "is_https": 0,
    "has_ip_address": 1, "has_suspicious_tld": 0, "subdomain_count": 2,
    "has_port": 0, "query_params_count": 2, "has_at_symbol": 1,
    "has_double_slash": 0, "special_char_count": 6
  }
}

### C4. web_attack_detection — phishing-shaped features
# Expect: HTTP 200
# prediction 1, prediction_label "threat", threat_score 1.0,
# inference_source "ml_model".
# @name predictWebAttack
POST {{space}}/api/models/predict
Content-Type: {{json}}

{
  "model_type": "web_attack_detection",
  "input_data": {
    "url_length": 78, "hostname_length": 12, "path_length": 32, "is_https": 0,
    "has_ip_address": 1, "has_suspicious_tld": 0, "subdomain_count": 2,
    "has_port": 0, "query_params_count": 2, "has_at_symbol": 1,
    "has_double_slash": 0, "special_char_count": 6
  }
}

### C5. anomaly_detection — benign-shaped features  (KNOWN ISSUE: labels inverted)
# Expect: HTTP 200
# The model is an IsolationForest: it returns 1 = normal, -1 = anomaly.
# The service treats 1 as "threat", so a NORMAL url comes back as
# prediction 1 / "threat" / threat_score 0.5, and an anomalous one as
# prediction -1 / "benign". This is why every clean URL in section E scores
# at least risk_score 50 ("medium").
# @name predictAnomalyBenignInput
POST {{space}}/api/models/predict
Content-Type: {{json}}

{
  "model_type": "anomaly_detection",
  "input_data": {
    "url_length": 45, "hostname_length": 14, "path_length": 7, "is_https": 1,
    "has_ip_address": 0, "has_suspicious_tld": 0, "subdomain_count": 1,
    "has_port": 0, "query_params_count": 1, "has_at_symbol": 0,
    "has_double_slash": 0, "special_char_count": 3
  }
}

### C6. anomaly_detection — phishing-shaped features (inverted, see C5)
# Expect: HTTP 200
# prediction -1, prediction_label "benign".
# @name predictAnomalyThreatInput
POST {{space}}/api/models/predict
Content-Type: {{json}}

{
  "model_type": "anomaly_detection",
  "input_data": {
    "url_length": 78, "hostname_length": 12, "path_length": 32, "is_https": 0,
    "has_ip_address": 1, "has_suspicious_tld": 0, "subdomain_count": 2,
    "has_port": 0, "query_params_count": 2, "has_at_symbol": 1,
    "has_double_slash": 0, "special_char_count": 6
  }
}

### C7. Empty input_data — falls back to the rule-based heuristic
# Expect: HTTP 200
# inference_source "heuristic", prediction 0, reasons [].
# @name predictEmptyInput
POST {{space}}/api/models/predict
Content-Type: {{json}}

{
  "model_type": "malware_detection",
  "input_data": {}
}

### C8. Unknown model name — heuristic, not an error
# Expect: HTTP 200
# inference_source "heuristic", prediction 1, threat_score 0.75,
# reasons ["No HTTPS","IP address in URL","Suspicious TLD"].
# @name predictUnknownModel
POST {{space}}/api/models/predict
Content-Type: {{json}}

{
  "model_type": "does_not_exist",
  "input_data": { "is_https": 0, "has_ip_address": 1, "has_suspicious_tld": 1 }
}

### C9. No body fields at all — defaults to phishing_detection + heuristic
# Expect: HTTP 200
# model "phishing_detection", inference_source "heuristic".
# @name predictDefaults
POST {{space}}/api/models/predict
Content-Type: {{json}}

{}


# =====================================================================
# D. EXPLAINABILITY — GET /api/v2/explain/{model_name}
# =====================================================================

### D1. phishing_detection
# Expect: HTTP 200
# method "gini_importance"; url_length 0.6632, special_char_count 0.3368,
# every other feature 0.0 (the model only uses two features).
# @name explainPhishing
GET {{space}}/api/v2/explain/phishing_detection

### D2. malware_detection
# Expect: HTTP 200
# method "gini_importance". The importances are IDENTICAL to D1
# (url_length 0.6632, special_char_count 0.3368) — see the note on D3.
# @name explainMalware
GET {{space}}/api/v2/explain/malware_detection

### D3. web_attack_detection
# Expect: HTTP 200
# Identical to D1 and D2 again. Three "different" detectors with the same
# importances to four decimals means they were trained on the same data and
# labels, so they behave as one model, not three independent signals.
# @name explainWebAttack
GET {{space}}/api/v2/explain/web_attack_detection

### D4. anomaly_detection — IsolationForest has no importances
# Expect: HTTP 200
# method "not_available".
# @name explainAnomaly
GET {{space}}/api/v2/explain/anomaly_detection

### D5. Unknown model
# Expect: HTTP 200
# {"error":"Model 'nope' not loaded","available":[...4 names...]}
# (HTTP 200 with an error field, not a 404.)
# @name explainUnknown
GET {{space}}/api/v2/explain/nope


# =====================================================================
# E. URL ANALYSIS — POST /analyze-url   (4 sklearn models + risk factors)
# =====================================================================

### E1. Benign URL
# Expect: HTTP 200
# phishing/malware/web_attack predict 0. aggregate.risk_factors [].
# aggregate.risk_score 50.0 / "medium" / models_flagged 1 — caused only by the
# inverted anomaly model (C5); the true result should be low.
# @name analyzeUrlBenign
POST {{space}}/analyze-url
Content-Type: {{json}}

{ "url": "https://www.google.com/search?q=cybersecurity" }

### E2. Phishing URL (raw IP, no HTTPS, @ symbol)
# Expect: HTTP 200
# risk_score 100.0, overall_risk_level "critical", models_flagged 3 of 4,
# risk_factors ["no_https","ip_in_url","at_symbol_in_url"].
# @name analyzeUrlPhishing
POST {{space}}/analyze-url
Content-Type: {{json}}

{ "url": "http://192.168.10.5/secure-login/paypal.com/verify?account=1&session=abc@evil" }

### E3. Suspicious TLD
# Expect: HTTP 200
# risk_score 57.4, overall_risk_level "medium", models_flagged 3,
# risk_factors ["no_https","suspicious_tld"].
# @name analyzeUrlSuspiciousTld
POST {{space}}/analyze-url
Content-Type: {{json}}

{ "url": "http://free-prizes.tk/win?id=1&ref=2" }

### E4. Every risk factor at once (long URL, port, subdomains, //, special chars)
# Expect: HTTP 200
# risk_score 100.0, "critical". risk_factors lists all seven: no_https,
# suspicious_tld, long_url, at_symbol_in_url, excessive_subdomains,
# high_special_chars, double_slash_in_path.
# features_analyzed: url_length 140, subdomain_count 4, has_port 1,
# query_params_count 6, special_char_count 25.
# @name analyzeUrlAllFactors
POST {{space}}/analyze-url
Content-Type: {{json}}

{ "url": "http://login.secure.account.update.example-bank.xyz:8080/a//b/verify.php?user=admin@corp&token=(abc)&redirect=[x];y=1&z=2&q=<script>&w=1,2,3" }

### E5. Missing url
# Expect: HTTP 400
# {"detail":"URL required"}
# @name analyzeUrlMissing
POST {{space}}/analyze-url
Content-Type: {{json}}

{}


