# =======================================================
# CYBER FORGE AI - BACKEND ENVIRONMENT CONFIGURATION
# =======================================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control!
# Only variables actually read by the code are listed here.

# =======================================================
# SERVER CONFIGURATION
# =======================================================
PORT=8000
NODE_ENV=development
APP_VERSION=1.0.0

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:8080

# =======================================================
# DATABASE & CACHE
# =======================================================
# MongoDB connection string
DATABASE_URL=mongodb://localhost:27017/cyberforge

# Redis connection string
REDIS_URL=redis://localhost:6379

# =======================================================
# SECURITY & AUTHENTICATION
# =======================================================
# Required before startup in every environment. No default or placeholder is accepted.
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Signing keys (Ed25519 seeds, 32 bytes, base64). Optional: without one, the
# feature it signs is off and says so. Generate each locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DEVICE_COMMAND_KEY signs commands sent to enrolled devices; changing it means
# enrolling each device again (docs/RECOVERY.md).
DEVICE_COMMAND_KEY=
# AUDIT_SIGNING_KEY signs audit checkpoints and evidence manifests.
AUDIT_SIGNING_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Firebase Admin (service account)
FIREBASE_PROJECT_ID=cyber-forge-ai
FIREBASE_PRIVATE_KEY_ID=your-firebase-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@cyber-forge-ai.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-firebase-client-id

# =======================================================
# APPWRITE CONTROL PLANE
# =======================================================
# Take all three from the same project (Appwrite console > Settings): a key only
# works in the project it was created in. The key needs the collections,
# attributes, indexes and documents scopes (read and write) and databases.
# Then run `npm --prefix backend run appwrite:schema` once to create the
# database and its collections.
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_API_KEY=your-appwrite-api-key
APPWRITE_DATABASE_ID=cyberforge
# Used only by scripts/setup-appwrite-schema.js
APPWRITE_DATABASE_NAME=cyberforge

# Appwrite Collection IDs
APPWRITE_COLLECTION_USERS=users
APPWRITE_COLLECTION_DEVICES=devices
APPWRITE_COLLECTION_BROWSERS=browsers
APPWRITE_COLLECTION_BROWSER_EVENTS=browser_events
APPWRITE_COLLECTION_AGENTS=agents
APPWRITE_COLLECTION_AGENT_TASKS=agent_tasks
APPWRITE_COLLECTION_ALERTS=alerts
APPWRITE_COLLECTION_BROWSER_INTELLIGENCE=browser_intelligence
APPWRITE_COLLECTION_EVIDENCE_METADATA=evidence_metadata
APPWRITE_COLLECTION_NETWORK_CAPTURES=network_captures

# =======================================================
# AI & MACHINE LEARNING SERVICES
# =======================================================
# Single destination for every backend ML client. Defaults to this Space if unset.
# AI_SERVICE_URL and HF_SPACE_URL are retired and no longer read by the backend.
# For an explicitly started local ML service, use http://127.0.0.1:8001 instead.
ML_SERVICE_URL=https://che237-cyberforge.hf.space
# The ML service refuses every call except /health without this key. Set the
# same value as the Space secret ML_SERVICE_KEY. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# It is sent only to ML_SERVICE_URL, in the X-CyberForge-Service-Key header.
ML_SERVICE_KEY=

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Vector database (Pinecone preferred, falls back to ChromaDB)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=cyber-forge-threats
CHROMA_URL=http://localhost:8000

# =======================================================
# EXTERNAL SERVICES & APIs
# =======================================================
# AlienVault OTX threat intelligence
OTX_API_KEY=your-otx-api-key

# Rendered-page scanner (WebScraper.live API v1). The base URL must be HTTPS;
# with a plain-HTTP value, or no key, URL scans report partial coverage.
WEBSCRAPER_API_URL=https://webscrapper.live
WEBSCRAPER_API_KEY=your-webscraper-api-key

# =======================================================
# LOGGING & DATADOG OBSERVABILITY
# =======================================================
LOG_LEVEL=info

DATADOG_ENABLED=true
DATADOG_API_KEY=your-datadog-api-key
DATADOG_SERVICE_NAME=cyberforge-backend
DATADOG_AGENT_HOST=localhost
DATADOG_AGENT_PORT=8126
DATADOG_LOG_LEVEL=info
DATADOG_PROFILING=false
DATADOG_RUNTIME_METRICS=true

# =======================================================
# DESKTOP APP (Tauri)
# =======================================================
# Read from the desktop app's process environment, not from this file.
# Set them in your shell before running `tauri dev` / the packaged app.
# HF_TOKEN=your-huggingface-token
# HF_CONFIG=path/to/hf_config.json
# DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3-0324
