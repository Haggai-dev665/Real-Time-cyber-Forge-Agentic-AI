### M1. /analyze — query containing a URL (runs phishing/malware/web-attack models)
# Expect: HTTP 200
# model_used "unsloth/Qwen3.5-2B-GGUF"; confidence 0.82;
# insights ["Analysis by unsloth/Qwen3.5-2B-GGUF via space_local_llamacpp"].
# risk_level is read from the "Risk Level: X" line of the answer: Critical 9.0,
# High 7.0, Medium 5.0, Low 3.0; Low when there is no such line.
# 2026-10-12: "Critical" for this raw-IP PayPal look-alike URL.
# @name analyzeWithUrl
POST {{space}}/analyze
Content-Type: {{json}}

{
  "query": "Check http://192.168.10.5/secure-login/paypal.com/verify?account=1&session=abc@evil",
  "context": { "user": "rest-test" },
  "conversation_history": []
}

