    "allow-resolve-ip",
    "allow-get-system-profile",
    "allow-get-path-status",
    "allow-add-to-path",
    "allow-get-browser-history",
    "allow-get-collected-history",
    "allow-is-installed",
    "allow-mark-installed",
    "allow-agent-status",
    "allow-scan-url",
    "allow-get-pending-threat",
    "allow-get-active-urls",
