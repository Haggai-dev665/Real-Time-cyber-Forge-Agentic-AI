Content-Type: {{json}}

{ "domain": "xkq7zt9bwpl3vnm2.com" }

### H3. Same DGA domain behind "www."  (KNOWN ISSUE: only the first label is scored)
# Expect: HTTP 200
# The detector analyses domain.split('.')[0], so it scores "www" and returns
# "legit" for an obviously generated domain. Pass the bare domain (H2) to get a
# real answer. I1 and J1 are affected the same way for URLs with subdomains.
# @name dgaSubdomainBlindSpot
POST {{space}}/api/v2/dga-detect
Content-Type: {{json}}

{ "domain": "www.xkq7zt9bwpl3vnm2.com" }

### H4. Missing domain
# Expect: HTTP 400
# {"detail":"domain required"}
# @name dgaMissing
POST {{space}}/api/v2/dga-detect
Content-Type: {{json}}

{}


