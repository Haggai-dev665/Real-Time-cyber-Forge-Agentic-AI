# =====================================================================
# L. CONTEXT-GROUNDED CHATBOT — POST /api/v2/chat
#    The in-Space model answers, so "model_used" is "unsloth/Qwen3.5-2B-GGUF";
#    the ML heuristic is the fallback.
#    Watch "sources" to confirm the context was parsed. If a request arrives
#    while the model is busy for more than 5 s, or still loading, the reply is
#    the template fallback with model_used "cyberforge-ml-fallback".
# =====================================================================

### L1. Plain message with a URL
# Expect: HTTP 200
# model_used "unsloth/Qwen3.5-2B-GGUF"; session_id echoed back; confidence 0.72;
# sources contains an "ml_scan" entry and an "ml_models" entry ("4/4 loaded").
# risk_level comes from the "Risk Level: X" line of the answer (2026-10-12:
# "high" / 70.0), raised to the ML scan score when that is higher.
# @name chatWithUrl
POST {{space}}/api/v2/chat
Content-Type: {{json}}

{
  "message": "Is http://paypal-secure-login.verify-account.xyz/update safe to open?",
  "session_id": "rest-test-1"
}

### L2. Message with no URL
# Expect: HTTP 200
# model_used "unsloth/Qwen3.5-2B-GGUF"; sources has only the "ml_models" entry.
# A general how-to question: the answer should have no risk line, so
# risk_level is "low" / 20.0 (the default when no risk line is present).
# @name chatNoUrl
POST {{space}}/api/v2/chat
Content-Type: {{json}}

{
  "message": "How do I recognise a phishing email?",
  "session_id": "rest-test-2"
}

### L3. Full live context (telemetry, scans, threats, behavioural alerts)
# Expect: HTTP 200
# sources types, in order: telemetry, scan_history, threats, behavioral,
# ml_models. telemetry value "CPU 42%, RAM 67%, Net↓ 120 kbps".
# The generated answer should mention the context that was sent (the
# free-prizes.tk scan at 78/100, the credential-form alert).
# @name chatFullContext
POST {{space}}/api/v2/chat
Content-Type: {{json}}

{
  "message": "Summarise my current security posture.",
  "session_id": "rest-test-3",
  "context": {
    "telemetry": { "cpu": 42, "ram": 67, "net_in_kbps": 120 },
    "recent_scans": [
      { "url": "http://free-prizes.tk/win", "risk_score": 78, "category": "phishing" },
      { "url": "https://github.com", "risk_score": 4, "category": "benign" }
    ],
    "active_threats": [
      { "type": "phishing", "severity": "high", "source": "browser-monitor" }
    ],
    "behavioral_alerts": [
      { "pattern": "credential form on new domain", "score": 0.9 }
    ]
  }
}

