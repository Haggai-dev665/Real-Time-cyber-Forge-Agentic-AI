# =====================================================================
# K. SECURITY LLM — POST /api/v2/security-chat
#    Answered by the open-source model running inside the Space
#    (Qwen3.5-2B on CPU). No hosted or paid model is involved.
# =====================================================================

### K1. Ask the security LLM
# Expect: HTTP 200
# model "local-llm", source "space_local_llamacpp", model_id "unsloth/Qwen3.5-2B-GGUF",
# "response" = generated text, plus tokens, elapsed_ms and truncated.
# Takes about 7-18 s. The text is generated, so it differs on every run.
# truncated true means the 17 s time limit or the token limit was reached and
# the answer was trimmed to its last complete sentence (2026-10-12: 95 tokens,
# truncated true).
# If no LLM answers (busy, still loading, or failed), the body is the
# rule-based fallback instead: model_used "cyberforge-ml-fallback".
# @name securityChat
POST {{space}}/api/v2/security-chat
Content-Type: {{json}}

{
  "query": "Explain what a DGA domain is and how to detect one.",
  "max_tokens": 200
}

### K2. Missing query
# Expect: HTTP 400
# {"detail":"query required"}
# @name securityChatMissing
POST {{space}}/api/v2/security-chat
Content-Type: {{json}}

{}


# =====================================================================
# L. CONTEXT-GROUNDED CHATBOT — POST /api/v2/chat
#    The in-Space model answers, so "model_used" is "unsloth/Qwen3.5-2B-GGUF";
#    the ML heuristic is the fallback.
#    Watch "sources" to confirm the context was parsed. If a request arrives
#    while the model is busy for more than 5 s, or still loading, the reply is
#    the template fallback with model_used "cyberforge-ml-fallback".
# =====================================================================

### L1. Plain message with a URL
# Expect: HTTP 200
# model_used "unsloth/Qwen3.5-2B-GGUF"; session_id echoed back; confidence 0.72;
# sources contains an "ml_scan" entry and an "ml_models" entry ("4/4 loaded").
# risk_level comes from the "Risk Level: X" line of the answer (2026-10-12:
# "high" / 70.0), raised to the ML scan score when that is higher.
# @name chatWithUrl
POST {{space}}/api/v2/chat
Content-Type: {{json}}

{
  "message": "Is http://paypal-secure-login.verify-account.xyz/update safe to open?",
  "session_id": "rest-test-1"
}

### L2. Message with no URL
# Expect: HTTP 200
# model_used "unsloth/Qwen3.5-2B-GGUF"; sources has only the "ml_models" entry.
# A general how-to question: the answer should have no risk line, so
# risk_level is "low" / 20.0 (the default when no risk line is present).
# @name chatNoUrl
POST {{space}}/api/v2/chat
Content-Type: {{json}}

{
  "message": "How do I recognise a phishing email?",
  "session_id": "rest-test-2"
}

### L3. Full live context (telemetry, scans, threats, behavioural alerts)
# Expect: HTTP 200
# sources types, in order: telemetry, scan_history, threats, behavioral,
# ml_models. telemetry value "CPU 42%, RAM 67%, Net↓ 120 kbps".
# The generated answer should mention the context that was sent (the
# free-prizes.tk scan at 78/100, the credential-form alert).
# @name chatFullContext
POST {{space}}/api/v2/chat
Content-Type: {{json}}

{
  "message": "Summarise my current security posture.",
  "session_id": "rest-test-3",
  "context": {
    "telemetry": { "cpu": 42, "ram": 67, "net_in_kbps": 120 },
    "recent_scans": [
      { "url": "http://free-prizes.tk/win", "risk_score": 78, "category": "phishing" },
      { "url": "https://github.com", "risk_score": 4, "category": "benign" }
    ],
    "active_threats": [
      { "type": "phishing", "severity": "high", "source": "browser-monitor" }
    ],
    "behavioral_alerts": [
      { "pattern": "credential form on new domain", "score": 0.9 }
    ]
  }
}

### L4. Translate mode (raw machine data -> plain language)
# Expect: HTTP 200
# sources contains a "raw_translation" entry whose value is the first 100
# characters of raw_data. The answer should restate the DGA alert in plain
# language. Check the wording: on 2026-10-12 it expanded DGA as "Distributed
# Denial of Attack", which is wrong (Domain Generation Algorithm).
# @name chatTranslate
POST {{space}}/api/v2/chat
Content-Type: {{json}}

{
  "message": "Explain this alert in plain English.",
  "session_id": "rest-test-4",
  "context": {
    "translate": true,
    "raw_data": "{\"model\":\"dga_detector\",\"prediction\":\"dga\",\"threat_score\":0.9,\"features\":{\"entropy\":4.0,\"vowel_ratio\":0.0}}"
  }
}

### L5. Conversation history
# Expect: HTTP 200
# History is only folded into the prompt when a context block is also sent,
# so this request includes telemetry. The answer should follow on from the
# earlier turns (the suspicious email link).
# @name chatHistory
POST {{space}}/api/v2/chat
Content-Type: {{json}}

{
  "message": "And what should I do about it?",
  "session_id": "rest-test-5",
  "conversation_history": [
    { "role": "user", "content": "I clicked a link in a suspicious email." },
    { "role": "assistant", "content": "That may be a phishing attempt." }
  ],
  "context": { "telemetry": { "cpu_percent": 12, "ram_percent": 40 } }
}

