{
  "name": "cyber-forge-ai-platform",
  "version": "1.0.0",
  "description": "🛡️ Advanced Real-Time Cybersecurity Platform with AI-Powered Threat Detection | Cross-platform desktop application featuring intelligent security monitoring, machine learning-based threat analysis, and agentic AI assistant | Built with Electron, React, TensorFlow, and LangChain | Comprehensive security analytics, real-time threat intelligence, and automated incident response capabilities",
  "private": true,
  "scripts": {
    "validate:updates": "npm --prefix backend run check",
    "install:all": "npm install && npm run install:desktop && npm run install:mobile && npm run install:backend && npm run install:ml",
    "install:desktop": "cd desktop && npm install",
    "install:mobile": "cd mobile-app && npm install",
    "install:backend": "cd backend && npm install",
    "install:ml": "cd ml-services && pip install -r requirements.txt",
    "dev": "npm run dev:backend",
    "dev:desktop": "cd desktop && npm run dev",
    "dev:mobile": "cd mobile-app && npm start",
    "dev:backend": "cd backend && npm run dev",
    "dev:ml": "cd ml-services && python main.py",
    "build": "npm run build:landing && npm run build:backend",
    "build:desktop": "cd desktop && npm run build",
    "build:mobile": "cd mobile-app && npm run build:android",
    "build:landing": "node scripts/sync-landing.js",
    "build:backend": "echo 'Backend build complete'",
    "start": "cd backend && npm start",
    "start:desktop": "cd desktop && npm run dev",
    "start:mobile": "cd mobile-app && npm start",
    "start:backend": "cd backend && npm start",
    "start:ml": "cd ml-services && python main.py",
    "heroku-postbuild": "cd backend && npm ci --omit=dev",
    "test": "npm run test:backend && npm run test:ml",
    "test:backend": "cd backend && npm test",
    "test:ml": "cd ml-services && pytest",
    "lint": "npm run lint:backend",
    "lint:backend": "cd backend && npm run lint",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "clean": "npm run clean:deps && npm run clean:builds",
    "clean:deps": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "clean:builds": "find . -name 'build' -type d -prune -exec rm -rf '{}' + && find . -name 'dist' -type d -prune -exec rm -rf '{}' +"
  },
  "keywords": [
    "cybersecurity",
    "ai",
    "machine-learning",
    "electron",
    "react-native",
    "next.js",
    "threat-detection",
    "security-analysis",
    "real-time-monitoring"
  ],
  "author": "Haggai-dev665",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0",
    "lerna": "^7.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Haggai-dev665/Real-Time-cyber-Forge-Agentic-AI.git"
  },
  "engines": {
    "node": "24.x"
  },
  "homepage": "https://github.com/Haggai-dev665/Real-Time-cyber-Forge-Agentic-AI#readme",
  "bugs": {
    "url": "https://github.com/Haggai-dev665/Real-Time-cyber-Forge-Agentic-AI/issues"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "heroku": "^8.7.1"
  }
}
