  "model_type": "malware_detection",
  "input_data": { "is_https": 0, "has_ip_address": 1, "has_suspicious_tld": 1 }
}

### C13. One model, asked by URL — a phishing-shaped host
# Expect: HTTP 200
# inference_source "ml_model", prediction 1, prediction_label "threat",
# threat_score 0.9952. The service computes the 39 features from the URL.
# @name predictByUrlPhishing
POST {{space}}/api/models/predict
Content-Type: {{json}}

{ "model_type": "phishing_detection", "url": "http://paypal-secure-login.verify-account.xyz/update/password.php" }

### C14. One model, asked by URL — a well-known site
# Expect: HTTP 200
# inference_source "ml_model", prediction 0, threat_score 0.0005.
# @name predictByUrlBenign
POST {{space}}/api/models/predict
Content-Type: {{json}}

{ "model_type": "malware_detection", "url": "https://www.wikipedia.org/" }


# =====================================================================
# D. EXPLAINABILITY — GET /api/v2/explain/{model_name}
# =====================================================================

### D1. phishing_detection
# Expect: HTTP 200
# method "permutation_importance" (measured at training, by shuffling each
# feature on held-out URLs); top_features begin domain_popularity, host_dots,
# path_depth, host_vowel_ratio, path_longest_token. "trained_at" is present.
# @name explainPhishing
GET {{space}}/api/v2/explain/phishing_detection

### D2. malware_detection
# Expect: HTTP 200
# method "permutation_importance"; top_features begin
# has_executable_extension, domain_popularity, bare_length, bare_path_length.
# Different from D1: the models are no longer copies of each other.
# @name explainMalware
GET {{space}}/api/v2/explain/malware_detection

### D3. web_attack_detection
# Expect: HTTP 200
# method "permutation_importance"; top_features begin payload_special_ratio,
# payload_spaces, payload_equals_in_value, count_percent, payload_angle_brackets.
# (Before 2026-10-13, D1, D2 and D3 returned identical importances over two
# features, url_length and special_char_count: three copies of one model.)
# @name explainWebAttack
GET {{space}}/api/v2/explain/web_attack_detection

### D4. anomaly_detection — IsolationForest has no importances
# Expect: HTTP 200
# method "not_available".
# @name explainAnomaly
GET {{space}}/api/v2/explain/anomaly_detection

### D5. Unknown model
# Expect: HTTP 200
# {"error":"Model 'nope' not loaded","available":[...4 names...]}
# (HTTP 200 with an error field, not a 404.)
# @name explainUnknown
GET {{space}}/api/v2/explain/nope


# =====================================================================
# E. URL ANALYSIS — POST /analyze-url   (4 sklearn models + risk factors)
# =====================================================================

### E1. Benign URL
# Expect: HTTP 200
# All four models predict 0. aggregate.risk_factors [], risk_score 39.7,
# overall_risk_level "low", models_flagged 0. Phishing, malware and web-attack
# score 0.0004, 0.0005 and 0.0003; the 39.7 is the anomaly model's margin score.
# @name analyzeUrlBenign
POST {{space}}/analyze-url
Content-Type: {{json}}

{ "url": "https://www.google.com/search?q=cybersecurity" }

### E2. Phishing URL (raw IP, no HTTPS, @ symbol)
# Expect: HTTP 200
# risk_score 100.0, overall_risk_level "critical", models_flagged 3 of 4,
# risk_factors ["no_https","ip_in_url","at_symbol_in_url"]. Phishing 0.9985,
# malware 0.9997, anomaly 0.5852. The web-attack model scores 0.0007: there is
# no injected payload in this URL, and it no longer fires on everything.
# @name analyzeUrlPhishing
POST {{space}}/analyze-url
Content-Type: {{json}}

{ "url": "http://192.168.10.5/secure-login/paypal.com/verify?account=1&session=abc@evil" }

### E3. Suspicious TLD
# Expect: HTTP 200
# risk_score 95.1, overall_risk_level "critical", models_flagged 1,
# risk_factors ["no_https","suspicious_tld"]. Phishing 0.9506; malware 0.1936.
# (Before the retraining this was 57.4 / "medium".)
# @name analyzeUrlSuspiciousTld
POST {{space}}/analyze-url
Content-Type: {{json}}

{ "url": "http://free-prizes.tk/win?id=1&ref=2" }

### E4. Every risk factor at once (long URL, port, subdomains, //, special chars)
# Expect: HTTP 200
# risk_score 100.0, "critical", models_flagged 3. risk_factors lists all seven:
# no_https, suspicious_tld, long_url, at_symbol_in_url, excessive_subdomains,
# high_special_chars, double_slash_in_path. Phishing and web-attack fire (the
# query carries a <script> tag); malware does not (0.30), there being no file.
# features_analyzed: url_length 140, subdomain_count 4, has_port 1,
# query_params_count 6, special_char_count 25, plus the newer features.
# @name analyzeUrlAllFactors
POST {{space}}/analyze-url
Content-Type: {{json}}

{ "url": "http://login.secure.account.update.example-bank.xyz:8080/a//b/verify.php?user=admin@corp&token=(abc)&redirect=[x];y=1&z=2&q=<script>&w=1,2,3" }

### E5. Missing url
# Expect: HTTP 400
# {"detail":"URL required"}
# @name analyzeUrlMissing
POST {{space}}/analyze-url
Content-Type: {{json}}

{}

### E6. Malware link on a raw IP address
# Expect: HTTP 200
# risk_score 100.0, "critical", models_flagged 3. malware 1.0, phishing 0.9988.
# (The first models scored this 0.0 on malware and called it "medium".)
# @name analyzeUrlMalwareLink
POST {{space}}/analyze-url
Content-Type: {{json}}

{ "url": "http://185.220.101.4:8080/bins/mips.sh" }

### E7. KNOWN FALSE POSITIVE — a Google Drive file link
# Expect: HTTP 200
# risk_score 91.1, "critical", models_flagged 1: the malware model scores a
# legitimate sharing link 0.9109. Collections of malware URLs contain many
# file-sharing links and the benign data few, and the text of the link cannot
# say whether the file is safe. Accepted by the owner on 2026-10-13 and
# recorded in malware_detection/metadata.json (gate.accepted_by_owner).
# @name analyzeUrlDriveFalsePositive
POST {{space}}/analyze-url
Content-Type: {{json}}

{ "url": "https://drive.google.com/file/d/1A2b3C4d5E6f7G8h9I0jKlMnOpQrStUv/view?usp=sharing" }

### E8. KNOWN FALSE POSITIVE — the Microsoft sign-in page
# Expect: HTTP 200
# risk_score 84.6, "critical", models_flagged 2: malware 0.8462 and the
# anomaly model 0.5263. Phishing is 0.4657, just under its decision point.
# A real sign-in URL carries a long identifier and other parameters, which is
# also what abuse looks like. Recorded with the model like E7.
# @name analyzeUrlSignInFalsePositive
POST {{space}}/analyze-url
Content-Type: {{json}}

{ "url": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize?client_id=4765445b-32c6-49b0-83e6-1d93765276ca&response_type=code&scope=openid" }

### E9. Cross-site scripting in a query value
# Expect: HTTP 200
# risk_score 100.0, "critical", models_flagged 1: web_attack 1.0, phishing
# 0.013, malware 0.3127. Only the model built for it fires.
# @name analyzeUrlXss
POST {{space}}/analyze-url
Content-Type: {{json}}

{ "url": "https://example.com/search?q=<script>alert(document.cookie)</script>" }

### E10. KNOWN MISS — path traversal
# Expect: HTTP 200
# risk_score 38.3, "low", models_flagged 0; web_attack 0.001. The web-attack
# model was trained on SQL-injection and XSS payloads only.
# @name analyzeUrlTraversalMiss
POST {{space}}/analyze-url
Content-Type: {{json}}

{ "url": "https://example.com/download?file=../../../../etc/passwd" }


